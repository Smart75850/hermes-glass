# Hermes Glass — 环境变量配置模板
# 复制为 ~/.hermes/.env 并填入实际值

# === 必填 ===
# DeepSeek API Key (在 https://platform.deepseek.com 获取)
DEEPSEEK_API_KEY=sk-your-key-here

# === 可选 ===
# API Server Key (Gateway 本地认证)
API_SERVER_KEY=hermes-mac-local-key-2026

# 允许所有用户访问 Gateway
GATEWAY_ALLOW_ALL_USERS=true

# === 注意 ===
# - 呢个文件包含密钥, 唔好提交到 git
# - 已在 .gitignore 中忽略
# - Hermes Glass 启动脚本会从此文件读取 API key
